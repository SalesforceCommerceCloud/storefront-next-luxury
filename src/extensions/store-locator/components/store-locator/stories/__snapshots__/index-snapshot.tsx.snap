    </h2>
    <section
      class="flex h-full min-h-0 flex-col"
      data-slot="luxury-boutique-finder"
      data-testid="boutique-directory"
    >
      <div
        class="flex min-h-0 flex-1 flex-col"
      >
        <div
          class="relative h-44 shrink-0 overflow-hidden"
        />
        <div
          class="@container flex min-h-0 flex-1 flex-col overflow-y-auto px-4 pt-6 pb-4"
        >
          <div
            class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2"
            data-testid="boutique-filters"
          >
            <div
              class="flex min-w-0 flex-col gap-2"
            >
              <label
                class="text-sm"
                for="boutique-filter-country"
              >
                Country
              </label>
              <div
                class="w-full [&>[data-slot=native-select-wrapper]]:w-full"
              >
                <div
                  class="group/native-select relative w-fit has-[select:disabled]:opacity-50"
                  data-slot="native-select-wrapper"
                >
                  <select
                    aria-label="Country"
                    class="border-input placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 dark:hover:bg-input/50 h-9 min-w-0 appearance-none rounded-ui border bg-transparent px-3 py-2 pr-9 text-sm shadow-ui transition-[color,box-shadow] outline-none disabled:pointer-events-none disabled:cursor-not-allowed data-[size=sm]:h-8 data-[size=sm]:py-1 focus-visible:border-ring focus-visible:ring-ring focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive w-full"
                    data-size="default"
                    data-slot="native-select"
                    id="boutique-filter-country"
                  >
                    <option
                      data-slot="native-select-option"
                      value=""
                    >
                      All countries
                    </option>
                  </select>
                  <svg
                    aria-hidden="true"
                    class="lucide lucide-chevron-down text-muted-foreground pointer-events-none absolute top-1/2 right-3.5 size-4 -translate-y-1/2 opacity-50 select-none"
                    data-slot="native-select-icon"
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="m6 9 6 6 6-6"
                    />
                  </svg>
                </div>
              </div>
            </div>
            <div
              class="flex min-w-0 flex-col gap-2"
            >
              <label
                class="text-sm"
                for="boutique-filter-postal"
              >
                ZIP or postal code
              </label>
              <input
                autocomplete="postal-code"
                class="file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 border-input h-9 w-full min-w-0 rounded-ui border bg-transparent px-3 py-1 text-base shadow-ui transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm focus-visible:border-ring focus-visible:ring-ring focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive"
                data-slot="input"
                id="boutique-filter-postal"
                value=""
              />
            </div>
          </div>
          <p
            class="mt-10 text-muted-foreground"
          >
            No boutiques match those filters.
          </p>
        </div>
      </div>
    </section>
  </section>
</div>
`;

