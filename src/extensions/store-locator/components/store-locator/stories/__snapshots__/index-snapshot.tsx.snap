                          <span
                            class="mt-2 text-center text-[0.6875rem] uppercase tracking-[0.12em] text-foreground"
                          >
                            Location
                          </span>
                        </div>
                        <span
                          aria-hidden="true"
                          class="mb-6 h-px w-6 bg-border"
                        />
                      </li>
                      <li
                        class="flex shrink-0 items-center"
                      >
                        <div
                          class="flex w-14 flex-col items-center"
                        >
                          <span
                            class="flex size-9 items-center justify-center border text-sm border-border text-muted-foreground"
                          >
                            2
                          </span>
                          <span
                            class="mt-2 text-center text-[0.6875rem] uppercase tracking-[0.12em] text-muted-foreground"
                          >
                            Service
                          </span>
                        </div>
                        <span
                          aria-hidden="true"
                          class="mb-6 h-px w-6 bg-border"
                        />
                      </li>
                      <li
                        class="flex shrink-0 items-center"
                      >
                        <div
                          class="flex w-14 flex-col items-center"
                        >
                          <span
                            class="flex size-9 items-center justify-center border text-sm border-border text-muted-foreground"
                          >
                            3
                          </span>
                          <span
                            class="mt-2 text-center text-[0.6875rem] uppercase tracking-[0.12em] text-muted-foreground"
                          >
                            Time
                          </span>
                        </div>
                        <span
                          aria-hidden="true"
                          class="mb-6 h-px w-6 bg-border"
                        />
