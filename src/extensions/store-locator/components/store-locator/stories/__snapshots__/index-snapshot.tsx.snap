                  >
                    Book an appointment
                  </h1>
                  <nav
                    aria-label="Book an appointment"
                    class="w-fit max-w-full shrink-0"
                  >
                    <ol
                      class="flex items-start"
                      data-testid="appointment-stepper"
                    >
                      <li
                        class="flex shrink-0 items-center"
                      >
                        <div
                          aria-current="step"
